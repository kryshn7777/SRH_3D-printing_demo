# Copy to .env.local. Leave both empty to run the local demo (data stays in this browser).
# Supabase Dashboard > Project Settings > API. The anon key is public by design: Row Level
# Security in supabase/schema.sql is what protects the data. NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
